+"""
+Ice Volume Estimation Module — CHANDRA-SITE Stage 3
+Team Anantavyoma | BAH 2026 PS8
+
+Takes each ice deposit produced by Stage 1 (DBSCAN clustering) and estimates
+a conservative-to-optimistic ice volume range using a dielectric mixing
+model, per the ISRO PS8 specification. LCROSS literature bounds the ice
+fraction between 0.5% (dry regolith with trace ice) and 5.6% (ice-rich
+permanently shadowed regions).
+
+This module does NOT prove ice is present — it turns a radar-derived
+confidence signal into a bounded volume estimate for mission planning.
+"""
+
+import json
+
+
+# ------------------------------
+# Constants (per ISRO PS8 spec / LCROSS literature)
+# ------------------------------
+
+EPSILON_ICE = 3.15
+EPSILON_DRY = 2.70
+
+F_ICE_LOW = 0.005   # 0.5% minimum ice fraction
+F_ICE_HIGH = 0.056  # 5.6% maximum ice fraction
+
+FIXED_DEPTH_M = 5.0            # metres, fixed per ISRO PS8 specification
+ROBUST_GO_THRESHOLD_M3 = 100   # lower-bound volume above which a GO holds
+
+
+def estimate_ice_volume(deposit_area_m2, cpr_mean, dop_mean):
+    """
+    Estimate ice volume range for a single deposit using a dielectric
+    mixing model driven by the deposit's mean CPR value.
+
+    Returns a dict with the low/high volume bounds (m^3), the fixed
+    depth used, and the ice fraction range applied.
+    """
+    # Estimate dielectric constant from CPR (DOP is used upstream as a
+    # confirmatory filter, not in this particular volume calculation)
+    epsilon_measured = EPSILON_DRY + (cpr_mean - 0.4) * 0.5
+
+    volume_low = deposit_area_m2 * FIXED_DEPTH_M * F_ICE_LOW
+    volume_high = deposit_area_m2 * FIXED_DEPTH_M * F_ICE_HIGH
+
+    return {
+        "volume_low_m3": round(volume_low, 1),
+        "volume_high_m3": round(volume_high, 1),
+        "depth_m": FIXED_DEPTH_M,
+        "ice_fraction_range": "0.5% to 5.6% (LCROSS literature)",
+        "epsilon_measured": round(epsilon_measured, 3),
+    }
+
+
+def robustness_check(volume_low_m3):
+    """
+    Checks whether a GO recommendation would still hold at the
+    conservative (lower-bound) volume estimate.
+    """
+    if volume_low_m3 >= ROBUST_GO_THRESHOLD_M3:
+        return "Robust GO — holds at conservative estimate"
+    return "Not robust — GO depends on optimistic estimate"
+
+
+def process_deposits(ice_deposits):
+    """
+    Batch-process every deposit from the Stage 1 output.
+
+    ice_deposits: list of dicts matching schema.json's "ice_deposits"
+    entries (id, area_m2, confidence, centroid, cpr_mean, dop_mean).
+
+    Returns the same list with estimated_depth_m / estimated_volume_m3
+    filled in (schema-compatible) plus the full volume range and
+    robustness flag for the summary report.
+    """
+    results = []
+    for deposit in ice_deposits:
+        volume = estimate_ice_volume(
+            deposit_area_m2=deposit["area_m2"],
+            cpr_mean=deposit["cpr_mean"],
+            dop_mean=deposit["dop_mean"],
+        )
+        robustness = robustness_check(volume["volume_low_m3"])
+
+        enriched = dict(deposit)
+        enriched["estimated_depth_m"] = volume["depth_m"]
+        # Conservative floor is used as the schema's single-value estimate;
+        # the full low/high range is kept alongside for the summary report.
+        enriched["estimated_volume_m3"] = volume["volume_low_m3"]
+        enriched["volume_low_m3"] = volume["volume_low_m3"]
+        enriched["volume_high_m3"] = volume["volume_high_m3"]
+        enriched["ice_fraction_range"] = volume["ice_fraction_range"]
+        enriched["robustness"] = robustness
+
+        results.append(enriched)
+    return results
+
+
+def generate_summary_report(processed_deposits):
+    """
+    Produce a formatted, human-readable ice resource summary report.
+    """
+    lines = []
+    lines.append("=" * 60)
+    lines.append("ICE RESOURCE SUMMARY REPORT")
+    lines.append("=" * 60)
+
+    for d in processed_deposits:
+        lines.append(f"\nDeposit #{d['id']}")
+        lines.append(f"  Area:              {d['area_m2']} m^2")
+        lines.append(f"  CPR / DOP mean:    {d['cpr_mean']} / {d['dop_mean']}")
+        lines.append(f"  Confidence:        {d['confidence'] * 100:.0f}%")
+        lines.append(f"  Depth (fixed):     {d['estimated_depth_m']} m")
+        lines.append(
+            f"  Volume range:      {d['volume_low_m3']} - "
+            f"{d['volume_high_m3']} m^3 ({d['ice_fraction_range']})"
+        )
+        lines.append(f"  Robustness:        {d['robustness']}")
+
+    lines.append("\n" + "=" * 60)
+    return "\n".join(lines)
+
+
+if __name__ == "__main__":
+    # Quick local test using the shared schema's sample data
+    with open("../Setup and Dashboard Foundation/sample_data.json") as f:
+        data = json.load(f)
+
+    processed = process_deposits(data["ice_deposits"])
+    print(generate_summary_report(processed))
+
+    with open("ice_volume_output.json", "w") as f:
+        json.dump({"ice_deposits": processed}, f, indent=2)
diff --git a/Mission Intelligence Engine/mission_intelligence.py b/Mission Intelligence Engine/mission_intelligence.py
new file mode 100644
index 0000000..9dfc35f
--- /dev/null
+++ b/Mission Intelligence Engine/mission_intelligence.py	
@@ -0,0 +1,178 @@
+"""
+Mission Intelligence Engine — CHANDRA-SITE Stage 3
+Team Anantavyoma | BAH 2026 PS8
+
+Combines Stage 1 (ice detection) and Stage 2 (terrain / rover feasibility)
+outputs into a single scientific-confidence score, engineering-feasibility
+score, and a GO / FURTHER INVESTIGATION / NO-GO mission recommendation,
+along with an honest uncertainty quantification report.
+
+This engine does not claim to prove ice exists — its job is to turn
+radar, imaging, and terrain signals into an evidence-based confidence
+level for ISRO review.
+"""
+
+
+# ------------------------------
+# Scientific Confidence Scorer (0-100)
+# ------------------------------
+
+def scientific_confidence(cpr_mean, dop_consistent, cnn_confidence, dbscan_continuity):
+    """
+    cpr_mean:          mean CPR value for the deposit
+    dop_consistent:    bool, True if DOP < 0.13 consistently across the deposit
+    cnn_confidence:    float 0-1, CNN's ice-class probability for the deposit
+    dbscan_continuity: bool, True if the DBSCAN cluster is spatially continuous
+    """
+    score = 0
+    if cpr_mean > 1.0:
+        score += 30
+    if dop_consistent:
+        score += 25
+    score += cnn_confidence * 25
+    if dbscan_continuity:
+        score += 20
+    return score  # 0 to 100
+
+
+# ------------------------------
+# Engineering Feasibility Scorer (0-100)
+# ------------------------------
+
+def engineering_feasibility(safety_score, traverse_feasibility, mission_energy_pct, ice_volume_low):
+    """
+    safety_score:          0-100, landing site safety score (Stage 2)
+    traverse_feasibility:  0-1 (or 0-100 scaled upstream), rover path feasibility
+    mission_energy_pct:    0-100, remaining battery % at rim / mission end
+    ice_volume_low:        m^3, conservative volume estimate (Ice Volume module)
+    """
+    score = 0
+    score += safety_score * 0.30
+    score += traverse_feasibility * 0.30
+    score += min(mission_energy_pct, 100) * 0.25
+    score += min(ice_volume_low / 500, 1.0) * 100 * 0.15
+    return score  # 0 to 100
+
+
+# ------------------------------
+# GO / FURTHER INVESTIGATION / NO-GO Decision Engine
+# ------------------------------
+
+def mission_recommendation(sci_confidence, eng_feasibility):
+    combined = (sci_confidence + eng_feasibility) / 2
+    if combined >= 70:
+        return "GO", "green", combined
+    elif combined >= 50:
+        return "FURTHER INVESTIGATION", "yellow", combined
+    else:
+        return "NO-GO", "red", combined
+
+
+# ------------------------------
+# Uncertainty Quantification Report
+# ------------------------------
+
+def uncertainty_report(cpr_std, cnn_variance, slope_accuracy, energy_estimate_error):
+    return {
+        "radar_uncertainty": "Low" if cpr_std < 0.15 else "Medium",
+        "ai_confidence": f"{(1 - cnn_variance) * 100:.0f}%",
+        "terrain_confidence": "High" if slope_accuracy > 0.85 else "Medium",
+        "energy_uncertainty": f"+/-{energy_estimate_error * 100:.0f}%",
+        "overall": (
+            "This system does not prove ice. It provides "
+            "evidence-based confidence for ISRO review."
+        ),
+    }
+
+
+# ------------------------------
+# Top-level orchestration
+# ------------------------------
+
+def build_mission_report(deposit, landing_site, rover_path, mission_inputs):
+    """
+    Wires the four functions above into one mission recommendation report
+    for a single deposit, matching schema.json's "mission_report" shape.
+
+    mission_inputs: dict expected to carry the signals not present in the
+    deposit / landing_site / rover_path dicts themselves, e.g.:
+        {
+            "dop_consistent": True,
+            "cnn_confidence": 0.87,
+            "dbscan_continuity": True,
+            "mission_energy_pct": 94,
+            "cpr_std": 0.09,
+            "cnn_variance": 0.08,
+            "slope_accuracy": 0.9,
+            "energy_estimate_error": 0.05,
+        }
+    """
+    sci = scientific_confidence(
+        cpr_mean=deposit["cpr_mean"],
+        dop_consistent=mission_inputs["dop_consistent"],
+        cnn_confidence=mission_inputs["cnn_confidence"],
+        dbscan_continuity=mission_inputs["dbscan_continuity"],
+    )
+
+    eng = engineering_feasibility(
+        safety_score=landing_site["safety_score"],
+        traverse_feasibility=rover_path["feasibility_score"],
+        mission_energy_pct=mission_inputs["mission_energy_pct"],
+        ice_volume_low=deposit.get("volume_low_m3", deposit.get("estimated_volume_m3", 0)),
+    )
+
+    recommendation, priority_color, combined_score = mission_recommendation(sci, eng)
+
+    priority = "High" if priority_color == "green" else (
+        "Medium" if priority_color == "yellow" else "Low"
+    )
+
+    uncertainty = uncertainty_report(
+        cpr_std=mission_inputs["cpr_std"],
+        cnn_variance=mission_inputs["cnn_variance"],
+        slope_accuracy=mission_inputs["slope_accuracy"],
+        energy_estimate_error=mission_inputs["energy_estimate_error"],
+    )
+
+    summary = (
+        f"Deposit #{deposit['id']}: scientific confidence {sci:.0f}/100, "
+        f"engineering feasibility {eng:.0f}/100, combined {combined_score:.0f}/100 "
+        f"-> {recommendation}."
+    )
+
+    return {
+        "scientific_confidence": round(sci, 1),
+        "engineering_feasibility": round(eng, 1),
+        "combined_score": round(combined_score, 1),
+        "mission_report": {
+            "recommendation": recommendation,
+            "priority": priority,
+            "summary": summary,
+        },
+        "uncertainty": uncertainty,
+    }
+
+
+if __name__ == "__main__":
+    # Quick local smoke test with representative values
+    demo_deposit = {
+        "id": 1, "area_m2": 8640, "confidence": 0.87,
+        "centroid": [-89.25, 45.32], "cpr_mean": 1.12, "dop_mean": 0.09,
+        "volume_low_m3": 216.0,
+    }
+    demo_landing_site = {"safety_score": 91, "halo_risk": False}
+    demo_rover_path = {"feasibility_score": 87}  # scaled 0-100 for this demo
+    demo_inputs = {
+        "dop_consistent": True,
+        "cnn_confidence": 0.9,
+        "dbscan_continuity": True,
+        "mission_energy_pct": 94,
+        "cpr_std": 0.09,
+        "cnn_variance": 0.08,
+        "slope_accuracy": 0.9,
+        "energy_estimate_error": 0.05,
+    }
+
+    report = build_mission_report(demo_deposit, demo_landing_site, demo_rover_path, demo_inputs)
+    import json
+    print(json.dumps(report, indent=2))
